@page "/"
@rendermode InteractiveServer

<PageTitle>Home</PageTitle>

<h1>Todo List</h1>

<AddTodo OnAdd="HandleAdd"/>

<TodoList Todos="todos" OnCheck="HandleCheck"/>

<TodoButton OnClick="HandleDeleteCompleted" IsDisabled="!todos.Any(todo => todo.IsCompleted)">Delete Completed Todos</TodoButton>

@code {
    private void HandleAdd(string text)
    {
        todos.Add(new Todo { Title = text });
    }

    private void HandleCheck(Todo todo)
    {
        todo.IsCompleted = !todo.IsCompleted;
    }

    private void HandleDeleteCompleted()
    {
        todos.RemoveAll(todo => todo.IsCompleted);
    }

    private List<Todo> todos = new()
        {
            new Todo { Title = "Todo 1" },
            new Todo { Title = "Todo 2" },
            new Todo { Title = "Todo 3", IsCompleted = true },
        };
}